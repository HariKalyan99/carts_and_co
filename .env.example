# ---- Browser-safe keys (VITE_ prefix = bundled into the frontend) ----

# Clerk → Configure → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Comma-separated emails allowed into the creator dashboard (empty = any signed-in user, dev only).
VITE_CREATOR_EMAILS=

# Supabase → Project Settings → Data API (URL) and API Keys (publishable key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Stripe → Developers → API keys (test mode) — phase 2
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- Server-only secrets: never prefix with VITE_, never commit ----
